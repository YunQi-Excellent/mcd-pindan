# 麦麦拼单 · 本地配置模板
#
# 用法：把本文件复制成 .env（注意是 .env，不是 .env.example），填入真实 Token。
#   cp .env.example .env
#
# .env 已被 .gitignore 屏蔽，不会进版本库。
# 本文件只放占位符，切勿把真实 Token 写进来。

# 必填：麦当劳 MCP Token
# 申请入口：https://open.mcd.cn/mcp （手机号登录 → 控制台 → 激活）
MCD_MCP_TOKEN=你的Token

# 选填：无法连通时再打开，用于绕过系统代理
# MCD_MCP_NO_PROXY=1

# 选填：使用自建网关时指定服务地址
# MCD_MCP_URL=https://mcp.mcd.cn
